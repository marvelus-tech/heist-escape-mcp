{
  "name": "heist-escape-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  
  "durable_objects": {
    "bindings": [
      { "name": "GAME_SESSION", "class_name": "GameSession" }
    ]
  },
  
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameSession"]
    }
  ],
  
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heist-db",
      "database_id": "2089771e-9509-424b-82ab-63a731fc882e"
    }
  ],
  
  "observability": {
    "enabled": true
  }
}
