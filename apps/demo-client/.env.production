# Production Environment (GitHub Pages + Cloudflare Worker)

# API Base URL - Replace with your deployed Cloudflare Worker URL
VITE_API_BASE=https://heist-escape-mcp.YOUR_ACCOUNT.workers.dev

# MCP Server URL - Replace with your deployed Worker URL + /mcp
VITE_MCP_URL=https://heist-escape-mcp.YOUR_ACCOUNT.workers.dev/mcp

# Base path for GitHub Pages (repo name)
VITE_BASE_PATH=/heist-escape-mcp/
